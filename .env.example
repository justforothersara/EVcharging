# 複製這個檔案的內容到 .env，填入自己的值
# 密碼請只用英文字母和數字：密碼會被放進 RabbitMQ 的連線網址裡，
# 如果含有 @ : / # 等符號，網址會被解析錯誤

# TDX 帳密（TDX 會員中心申請）
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=ev_charging
MYSQL_USER=ev
MYSQL_PASSWORD=

# MySQL 唯讀帳號（給 Redash 查詢用，只有 SELECT 權限）
MYSQL_RO_USER=ev_ro
MYSQL_RO_PASSWORD=

# RabbitMQ
RABBITMQ_USER=ev
RABBITMQ_PASSWORD=

# Redash（各填 32 個英文字母和數字，三個值都不同）
# 產生方式：在終端機執行 openssl rand -hex 16
REDASH_SECRET_KEY=
REDASH_COOKIE_SECRET=
REDASH_POSTGRES_PASSWORD=
